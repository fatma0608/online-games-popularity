def objective_xgb(trial, cv):
    params = {
        'n_estimators'    : trial.suggest_int('n_estimators', 100, 400),
        'max_depth'       : trial.suggest_int('max_depth', 3, 10),
        'learning_rate'   : trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
        'subsample'       : trial.suggest_float('subsample', 0.6, 1.0),
        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),
        'gamma'           : trial.suggest_float('gamma', 0, 5),
        'reg_alpha'       : trial.suggest_float('reg_alpha', 0, 2),
        'reg_lambda'      : trial.suggest_float('reg_lambda', 0, 2),
    }
    

    model = XGBClassifier(**params, random_state=RANDOM_STATE, n_jobs=-1,
                          eval_metric='logloss', verbosity=0)

    # Manual CV loop — avoids fit_params which needs sklearn >= 1.4
    scores = []
    for train_idx, val_idx in cv.split(X_train, y_train):
        X_tr, X_val = X_train.iloc[train_idx], X_train.iloc[val_idx]
        y_tr, y_val = y_train.iloc[train_idx], y_train.iloc[val_idx]
        w_tr = compute_sample_weight('balanced', y_tr)
        model.fit(X_tr, y_tr, sample_weight=w_tr)
        preds = model.predict(X_val)
        from sklearn.metrics import f1_score
        scores.append(f1_score(y_val, preds, average='macro'))
    return np.mean(scores)

def objective_lgbm(trial, cv):
    params = {
        'n_estimators'    : trial.suggest_int('n_estimators', 100, 400),
        'max_depth'       : trial.suggest_int('max_depth', 3, 10),
        'learning_rate'   : trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
        'num_leaves'      : trial.suggest_int('num_leaves', 20, 100),
        'subsample'       : trial.suggest_float('subsample', 0.6, 1.0),
        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),
        'reg_alpha'       : trial.suggest_float('reg_alpha', 0, 2),
        'reg_lambda'      : trial.suggest_float('reg_lambda', 0, 2),
                'class_weight'    : 'balanced',
    }
    model = LGBMClassifier(**params, random_state=RANDOM_STATE, n_jobs=-1, verbose=-1)
    return cross_val_score(model, X_train, y_train, cv=cv, scoring='f1_macro').mean()


def objective_cat(trial, cv):
    params = {
        'iterations'   : trial.suggest_int('iterations', 100, 400),
        'depth'        : trial.suggest_int('depth', 3, 8),
        'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
        'l2_leaf_reg'  : trial.suggest_float('l2_leaf_reg', 1, 10),
        'border_count' : trial.suggest_int('border_count', 32, 255),
                'auto_class_weights': 'Balanced',
    }
    model = CatBoostClassifier(**params, random_state=RANDOM_STATE, verbose=0)
    return cross_val_score(model, X_train, y_train, cv=cv, scoring='f1_macro').mean()


def objective_lr(trial, cv):
    params = {
        'C'       : trial.suggest_float('C', 0.01, 10, log=True),
        'solver'  : trial.suggest_categorical('solver', ['lbfgs', 'saga']),
        'max_iter': trial.suggest_int('max_iter', 200, 1000),
    }
    model = LogisticRegression(**params, random_state=RANDOM_STATE, n_jobs=-1)
    return cross_val_score(model, X_train, y_train, cv=cv, scoring='f1_macro').mean()


def objective_svm(trial, cv):
    params = {
        'C'     : trial.suggest_float('C', 0.01, 10, log=True),
        'gamma' : trial.suggest_categorical('gamma', ['scale', 'auto']),
        'kernel': trial.suggest_categorical('kernel', ['rbf', 'poly', 'sigmoid']),
    }
    model = SVC(**params, random_state=RANDOM_STATE, probability=True)
    return cross_val_score(model, X_train, y_train, cv=cv, scoring='f1_macro').mean()


# Map name → (objective_fn, model_class)
models_registry = {
    'Random Forest'      : (objective_rf,   RandomForestClassifier),
    'Extra Trees'        : (objective_et,   ExtraTreesClassifier),
    'Gradient Boosting'  : (objective_gb,   GradientBoostingClassifier),
    'XGBoost'            : (objective_xgb,  XGBClassifier),
    'LightGBM'           : (objective_lgbm, LGBMClassifier),
    'CatBoost'           : (objective_cat,  CatBoostClassifier),
    'Logistic Regression': (objective_lr,   LogisticRegression),
    'SVM'                : (objective_svm,  SVC),
}


# =========================================================
# HELPER: run one Optuna study
# =========================================================
def run_study(name, objective_fn, cv, n_trials, n_jobs=OPTUNA_JOBS):
    """Create a study with MedianPruner and return (best_score, best_params)."""
    pruner = optuna.pruners.MedianPruner(n_startup_trials=5, n_warmup_steps=0)
    study  = optuna.create_study(direction='maximize', pruner=pruner)
    study.optimize(
        lambda trial: objective_fn(trial, cv),
        n_trials=n_trials,
        n_jobs=n_jobs,
        show_progress_bar=True,
    )
    return study.best_value, study.best_params


# =========================================================
# PHASE 1 — Quick sweep across all models
# =========================================================
print("\n" + "="*60)
print("PHASE 1: Quick sweep (3-fold CV, 20 trials per model)")
print("="*60)

phase1_results = {}

for name, (objective_fn, _) in models_registry.items():
    print(f"\n🔍 [{name}] — phase 1 ...")
    score, params = run_study(name, objective_fn, cv_fast, n_trials=PHASE1_TRIALS)
    phase1_results[name] = {'score': score, 'params': params}
    print(f"   CV Accuracy (3-fold): {score:.4f}")

phase1_df = (
    pd.DataFrame({'CV Accuracy (3-fold)': {k: v['score'] for k, v in phase1_results.items()}})
    .sort_values('CV Accuracy (3-fold)', ascending=False)
)
print("\n📋 Phase 1 Ranking:")
print(phase1_df.to_string())

top_models = phase1_df.index[:TOP_N_MODELS].tolist()
print(f"\n🏅 Top {TOP_N_MODELS} selected for deep tuning: {top_models}")


# =========================================================
# PHASE 2 — Deep tune on top models only
# =========================================================
print("\n" + "="*60)
print(f"PHASE 2: Deep tune (5-fold CV, 50 trials) on top {TOP_N_MODELS} models")
print("="*60)

phase2_results = {}

for name in top_models:
    objective_fn, _ = models_registry[name]
    print(f"\n🔬 [{name}] — phase 2 ...")
    score, params = run_study(name, objective_fn, cv_full, n_trials=PHASE2_TRIALS)
    phase2_results[name] = {'score': score, 'params': params}
    print(f"   CV Accuracy (5-fold): {score:.4f}")

phase2_df = (
    pd.DataFrame({'CV Accuracy (5-fold)': {k: v['score'] for k, v in phase2_results.items()}})
    .sort_values('CV Accuracy (5-fold)', ascending=False)
)
print("\n🏆 Phase 2 Ranking:")
print(phase2_df.to_string())


# =========================================================
# PICK WINNER & RETRAIN
# =========================================================
best_model_name = phase2_df.index[0]
best_params     = phase2_results[best_model_name]['params']

print(f"\n🥇 Best Model : {best_model_name}")
print(f"   Best Params: {best_params}")

# Some models need extra kwargs that aren't tunable
extra_kwargs = {
    'XGBoost'            : {'eval_metric': 'logloss', 'verbosity': 0, 'n_jobs': -1},
    'LightGBM'           : {'verbose': -1, 'n_jobs': -1},
    'CatBoost'           : {'verbose': 0},
    'Random Forest'      : {'n_jobs': -1},
    'Extra Trees'        : {'n_jobs': -1},
    'Logistic Regression': {'n_jobs': -1},
}

_, ModelClass = models_registry[best_model_name]
kwargs = {**best_params, 'random_state': RANDOM_STATE, **extra_kwargs.get(best_model_name, {})}
final_model = ModelClass(**kwargs)
final_model.fit(X_train, y_train)
y_pred = final_model.predict(X_test)

print("\n📊 Test Set Results:")
print(classification_report(y_test, y_pred))
print("Confusion Matrix:")
print(confusion_matrix(y_test, y_pred))